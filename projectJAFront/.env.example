VITE_API_URL=http://127.0.0.1:8000

# Laravel Reverb (sync en tiempo real — solo páginas que lo activen, p. ej. organizaciones)
# Deben coincidir con REVERB_* del backend (.env.example)
VITE_REVERB_APP_KEY=local-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Imagen lateral del login (opcional). Si está vacío usa src/assets/brand/login-hero.jpg
# VITE_LOGIN_HERO_URL=https://tu-cdn/hero.jpg

# Google Maps (Drawing + Geometry) para el módulo de terrenos
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Web config (Console → Project settings → Your apps → Web app)
# Proyecto: projectja-2d55d
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=projectja-2d55d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=projectja-2d55d
VITE_FIREBASE_STORAGE_BUCKET=projectja-2d55d.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
